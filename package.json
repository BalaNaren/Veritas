{
  "name": "veritas-cli",
  "version": "0.1.0",
  "description": "An AI task agent that proves its work: parallel agents do the job and every claim is verified against its source.",
  "license": "Apache-2.0",
  "author": "Bala Naren Chanumolu <4568naren@gmail.com>",
  "homepage": "https://github.com/BalaNaren/Veritas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BalaNaren/Veritas.git"
  },
  "bugs": {
    "url": "https://github.com/BalaNaren/Veritas/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "verification",
    "research",
    "citations",
    "cli",
    "claude"
  ],
  "type": "module",
  "bin": {
    "veritas": "bin/veritas.js"
  },
  "files": [
    "bin",
    "dist",
    "docker",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean-check": "node scripts/clean-check.mjs",
    "test": "npm run clean-check && vitest run",
    "test:watch": "vitest",
    "eval:verify": "npm run build && node scripts/eval-verify.mjs",
    "probe:permissions": "npm run build && node scripts/probe-permissions.mjs",
    "art": "npm run build && node scripts/make-readme-art.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "docx": "9.15.3",
    "exceljs": "4.4.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "pdfmake": "0.3.14"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
